# Copy this file to ".env" and put your real key in it.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Model used for generation. The docs mention gemini-1.5-pro, but Google has retired
# the 1.5 family, so use a current model. Change here if you want a different one
# (e.g. gemini-2.5-pro for higher quality, gemini-2.5-flash for speed).
GEMINI_MODEL=gemini-2.5-flash

# Where the Streamlit frontend finds the FastAPI backend
BACKEND_URL=http://localhost:8000
